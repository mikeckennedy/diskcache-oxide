diff --git a/crates/diskcache-oxide-core/src/sentinel.rs b/crates/diskcache-oxide-core/src/sentinel.rs
new file mode 100644
index 00000000..75aeaee0
--- /dev/null
+++ b/crates/diskcache-oxide-core/src/sentinel.rs
@@ -0,0 +1,170 @@
+//! PROTOTYPE, plan 33 candidate S. Never merged: no fork handling, and it reads environment variables.
+//!
+//! One extra connection per store sits inside a read transaction. SQLite's unix VFS counts shared
+//! `-shm` locks per process and calls `fcntl` only when a count leaves or returns to zero, so while
+//! the sentinel holds the current read mark, every other connection's read in this process starts and
+//! ends with no lock system call (and, with frames in the WAL, no `fstat` either).
+//!
+//! A held mark must not go stale, or it pins the WAL and the readers move to another mark and pay the
+//! system calls again. So the sentinel is dropped to be taken again ("disarmed") when a connection sees
+//! that the database changed (`SQLITE_FCNTL_DATA_VERSION`, read after each operation: no lock, no
+//! system call), every `DCO_PROTO_SENTINEL_MS` milliseconds (default 50; a checkpoint in another
+//! process changes no data), and around this process's own checkpoints.
+#![allow(unsafe_code)]
+
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Mutex, OnceLock, PoisonError};
+use std::time::Instant;
+
+use rusqlite::Connection;
+
+fn setting(name: &str, default: u64) -> u64 {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+/// `DCO_PROTO_SENTINEL=1` turns the prototype on.
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| setting("DCO_PROTO_SENTINEL", 0) == 1)
+}
+
+fn refresh_ms() -> u64 {
+    static MS: OnceLock<u64> = OnceLock::new();
+    *MS.get_or_init(|| setting("DCO_PROTO_SENTINEL_MS", 50))
+}
+
+/// `DCO_PROTO_SENTINEL_QUIET`: operations in a row that must see no change before the sentinel is taken.
+fn quiet_needed() -> u64 {
+    static N: OnceLock<u64> = OnceLock::new();
+    *N.get_or_init(|| setting("DCO_PROTO_SENTINEL_QUIET", 0))
+}
+
+fn now_ms() -> u64 {
+    static START: OnceLock<Instant> = OnceLock::new();
+    u64::try_from(START.get_or_init(Instant::now).elapsed().as_millis()).unwrap_or(u64::MAX)
+}
+
+/// The connection's data version: changes whenever the database content this connection sees has
+/// changed, by any connection in any process. Reads a field of the pager; takes no file lock.
+pub fn data_version(conn: &Connection) -> u32 {
+    let mut version: u32 = 0;
+    // SAFETY: the handle is a live connection for the length of the call, "main" always exists, and
+    // SQLITE_FCNTL_DATA_VERSION writes one unsigned int through the pointer.
+    unsafe {
+        rusqlite::ffi::sqlite3_file_control(
+            conn.handle(),
+            c"main".as_ptr(),
+            rusqlite::ffi::SQLITE_FCNTL_DATA_VERSION,
+            std::ptr::from_mut(&mut version).cast(),
+        );
+    }
+    version
+}
+
+/// `BEGIN` and one read of the schema table, which is what takes the read mark. Cached statements:
+/// this runs after every commit the process sees.
+fn begin_read(conn: &Connection) -> rusqlite::Result<()> {
+    conn.prepare_cached("BEGIN")?.raw_execute()?;
+    conn.prepare_cached("SELECT 1 FROM sqlite_schema LIMIT 1")?.exists([])?;
+    Ok(())
+}
+
+#[derive(Debug, Default)]
+pub struct Sentinel {
+    conn: Mutex<Option<Connection>>,
+    armed: AtomicBool,
+    armed_at_ms: AtomicU64,
+    /// Checkpoints of this process in progress: the sentinel stays down while one runs.
+    paused: AtomicUsize,
+    closed: AtomicBool,
+    /// Operations in a row that saw no change.
+    quiet: AtomicU64,
+    pub arms: AtomicU64,
+}
+
+impl Sentinel {
+    /// Makes sure the sentinel holds a read transaction. The fast path is one load and one clock read.
+    pub fn ensure(&self, connect: impl FnOnce() -> crate::Result<Connection>) {
+        if self.armed.load(Ordering::Relaxed) {
+            let every = refresh_ms();
+            if every == 0 || now_ms().saturating_sub(self.armed_at_ms.load(Ordering::Relaxed)) < every {
+                return;
+            }
+            self.disarm();
+        }
+        if self.paused.load(Ordering::Acquire) > 0
+            || self.closed.load(Ordering::Acquire)
+            || self.quiet.load(Ordering::Relaxed) < quiet_needed()
+        {
+            return;
+        }
+        let mut slot = self.conn.lock().unwrap_or_else(PoisonError::into_inner);
+        if self.armed.load(Ordering::Acquire) || self.closed.load(Ordering::Acquire) {
+            return;
+        }
+        if slot.is_none() {
+            let Ok(conn) = connect() else { return };
+            *slot = Some(conn);
+        }
+        if let Some(conn) = slot.as_ref()
+            && begin_read(conn).is_ok()
+        {
+            self.armed_at_ms.store(now_ms(), Ordering::Relaxed);
+            self.arms.fetch_add(1, Ordering::Relaxed);
+            self.armed.store(true, Ordering::Release);
+        }
+    }
+
+    /// Ends the sentinel's read transaction; the next `ensure` starts a new one on the current state.
+    pub fn disarm(&self) {
+        if !self.armed.load(Ordering::Acquire) {
+            return;
+        }
+        let slot = self.conn.lock().unwrap_or_else(PoisonError::into_inner);
+        if self.armed.swap(false, Ordering::AcqRel)
+            && let Some(conn) = slot.as_ref()
+        {
+            let _ = conn.prepare_cached("ROLLBACK").and_then(|mut end| end.raw_execute());
+        }
+    }
+
+    /// An operation ended and its connection saw the same database as before.
+    pub fn quiet(&self) {
+        if !self.armed.load(Ordering::Relaxed) {
+            self.quiet.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    /// An operation ended and its connection saw a changed database.
+    pub fn changed(&self) {
+        self.quiet.store(0, Ordering::Relaxed);
+        self.disarm();
+    }
+
+    /// Keeps the sentinel down until the guard drops (around a checkpoint by this process).
+    pub fn pause(&self) -> Pause<'_> {
+        self.paused.fetch_add(1, Ordering::AcqRel);
+        self.disarm();
+        Pause(self)
+    }
+
+    pub fn close(&self) {
+        self.closed.store(true, Ordering::Release);
+        let mut slot = self.conn.lock().unwrap_or_else(PoisonError::into_inner);
+        self.armed.store(false, Ordering::Release);
+        *slot = None;
+    }
+
+    pub fn reopen(&self) {
+        self.closed.store(false, Ordering::Release);
+    }
+}
+
+#[derive(Debug)]
+pub struct Pause<'s>(&'s Sentinel);
+
+impl Drop for Pause<'_> {
+    fn drop(&mut self) {
+        self.0.paused.fetch_sub(1, Ordering::AcqRel);
+    }
+}
