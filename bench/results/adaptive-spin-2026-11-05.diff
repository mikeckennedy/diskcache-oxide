+        let mut e = 32;
+        for _ in 0..200 {
+            let next = next_estimate(e, Outcome::Got(300), 32, 1024);
+            assert!(next >= e && next <= 300);
+            e = next;
+        }
+        assert!((292..=300).contains(&e), "{e}");
+        // Down, the usual case once warm: `spent < estimate` must not wrap.
+        let mut e = 1000;
+        for _ in 0..200 {
+            let next = next_estimate(e, Outcome::Got(40), 0, 1024);
+            assert!(next <= e && next >= 40, "{e} -> {next}");
+            e = next;
+        }
+        assert!((40..=48).contains(&e), "{e}");
+        // `spent == 0`.
+        assert_eq!(next_estimate(512, Outcome::Got(0), 0, 1024), 448);
+        assert_eq!(next_estimate(512, Outcome::Got(0), 32, 1024), 448);
+        assert_eq!(next_estimate(7, Outcome::Got(0), 0, 1024), 7, "a step under an eighth rounds to none");
+        // Every pair in range stays in range, and moves the right way.
+        for e in [0, 1, 31, 32, 33, 100, 512, 1023, 1024, 40_000, u32::MAX] {
+            for spent in [0, 1, 32, 100, 512, 1024, 4096, u32::MAX] {
+                let next = next_estimate(e, Outcome::Got(spent), 32, 1024);
+                assert!((32..=1024).contains(&next), "{e} {spent} -> {next}");
+                let held = e.clamp(32, 1024);
+                if spent < e {
+                    assert!(next <= held, "{e} {spent} -> {next}");
+                } else {
+                    assert!(next >= held.min(spent.min(1024)), "{e} {spent} -> {next}");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn a_mutex_decayed_to_the_floor_recovers_when_holds_fit_the_floor_budget() {
+        let mut e = INITIAL_ESTIMATE;
+        for _ in 0..20 {
+            e = next_estimate(e, Outcome::Failed, SPIN_FLOOR, SPIN_HINTS);
+        }
+        assert_eq!(e, SPIN_FLOOR);
+        let floor_budget = budget(e, SPIN_FLOOR, SPIN_HINTS);
+        // Spins that succeed near the floor budget raise the estimate, and with it the budget.
+        for _ in 0..100 {
+            let b = budget(e, SPIN_FLOOR, SPIN_HINTS);
+            e = next_estimate(e, Outcome::Got(b), SPIN_FLOOR, SPIN_HINTS);
+        }
+        assert!(budget(e, SPIN_FLOOR, SPIN_HINTS) > floor_budget, "{e}");
+    }
+
+    #[test]
+    fn the_probe_fires_every_64th_contended_enter_and_its_count_wraps() {
+        let policy = policy_of(SPIN_HINTS, NO_CAP, Adapt::Probe);
+        let mut word = 100;
+        let mut probes = vec![];
+        for i in 0..640 {
+            if is_probe(word) {
+                probes.push(i);
+            }
+            // A spin that took exactly the estimate leaves it where it is.
+            word = next_word(word, Outcome::Got(word & ESTIMATE_MASK), policy);
+            assert_eq!(word & ESTIMATE_MASK, 100);
+        }
+        assert_eq!(probes, (0..10).map(|k| 64 * k + 63).collect::<Vec<_>>());
+        // The count wraps at 16 bits without touching the estimate, and the period holds across it.
+        let top = (0xFFFF << 16) | 0x64;
+        assert!(is_probe(top), "65,536 is a multiple of 64");
+        assert_eq!(next_word(top, Outcome::Got(100), policy), 100);
+        // Plain decay keeps no count.
+        let decay = policy_of(SPIN_HINTS, NO_CAP, Adapt::Decay);
+        assert_eq!(next_word(top, Outcome::Got(100), decay), 100);
+    }
+
+    #[test]
+    fn no_budget_touches_nothing() {
+        let p = Shared(alloc(ffi::SQLITE_MUTEX_FAST));
+        // SAFETY: `p` is live until the `free` at the end.
+        let m = unsafe { mutex(p.0) };
+        enter(p);
+        for adapt in [Adapt::Fixed, Adapt::Decay, Adapt::Probe] {
+            assert!(!spin(m, policy_of(0, 1, adapt)));
+        }
+        assert_eq!((spinners(p), estimate_word(p)), (0, INITIAL_ESTIMATE));
+        leave(p);
+        free(p);
+    }
+
+    /// An enter the cap turns away blocks at once and changes neither the count nor the estimate.
+    #[test]
+    fn a_capped_enter_changes_nothing() {
+        let p = Shared(alloc(ffi::SQLITE_MUTEX_FAST));
+        // SAFETY: `p` is live until the `free` at the end.
+        let m = unsafe { mutex(p.0) };
+        enter(p);
+        m.spinners.store(2, Ordering::Relaxed);
+        for adapt in [Adapt::Fixed, Adapt::Decay, Adapt::Probe] {
+            assert!(!spin(m, policy_of(SPIN_HINTS, 2, adapt)));
+            assert_eq!((spinners(p), estimate_word(p)), (2, INITIAL_ESTIMATE), "{adapt:?}");
+        }
+        // Below the cap it spins (and fails: this thread holds it), gives its count back, and decays.
+        m.spinners.store(0, Ordering::Relaxed);
+        assert!(!spin(m, policy_of(SPIN_HINTS, 2, Adapt::Decay)));
+        assert_eq!((spinners(p), estimate_word(p)), (0, INITIAL_ESTIMATE / 2));
+        // A failed spin under the fixed policy leaves the estimate alone.
+        assert!(!spin(m, policy_of(SPIN_HINTS, 1, Adapt::Fixed)));
+        assert_eq!((spinners(p), estimate_word(p)), (0, INITIAL_ESTIMATE / 2));
+        leave(p);
+        free(p);
+    }
+
+    /// As `contended_increments_lose_nothing`, under each cap and adaptation, and the spinner count
+    /// comes back to 0. The recursive mutex is entered twice per increment, the second time while
+    /// held, so re-entry runs under contention too.
+    #[test]
+    fn adaptive_contended_increments_lose_nothing_and_leak_no_spinner() {
+        const THREADS: u64 = 8;
+        const EACH: u64 = 5_000;
+        for id in [ffi::SQLITE_MUTEX_FAST, ffi::SQLITE_MUTEX_RECURSIVE] {
+            for cap in [0, 1, 2, NO_CAP] {
+                for adapt in [Adapt::Fixed, Adapt::Decay, Adapt::Probe] {
+                    let policy = policy_of(SPIN_HINTS, cap, adapt);
+                    let p = Shared(alloc(id));
+                    let count = AtomicU64::new(0);
+                    let start = Barrier::new(usize::try_from(THREADS).unwrap());
+                    let (count_ref, start) = (&count, &start);
+                    thread::scope(|s| {
+                        for _ in 0..THREADS {
+                            s.spawn(move || {
+                                let count = count_ref;
+                                start.wait();
+                                for _ in 0..EACH {
+                                    enter_under(p, policy);
+                                    if id == ffi::SQLITE_MUTEX_RECURSIVE {
+                                        enter_under(p, policy);
+                                    }
+                                    count.store(count.load(Ordering::Relaxed) + 1, Ordering::Relaxed);
+                                    if id == ffi::SQLITE_MUTEX_RECURSIVE {
+                                        leave(p);
+                                    }
+                                    leave(p);
+                                }
+                            });
+                        }
+                    });
+                    let what = format!("id {id}, cap {cap}, {adapt:?}");
+                    assert_eq!(count.into_inner(), THREADS * EACH, "{what}");
+                    assert_eq!(spinners(p), 0, "a leaked spinner count: {what}");
+                    let estimate = estimate_word(p) & ESTIMATE_MASK;
+                    assert!((SPIN_FLOOR..=SPIN_HINTS).contains(&estimate), "{what}: {estimate}");
+                    free(p);
+                }
+            }
+        }
+    }
+
+    /// The atfork child handler's body, called directly, zeroes a raised static count.
+    #[test]
+    fn the_fork_child_handler_zeroes_the_static_spinner_counts() {
+        let p = Shared(alloc(ffi::SQLITE_MUTEX_STATIC_APP2));
+        // SAFETY: a static, live for the process.
+        let m = unsafe { mutex(p.0) };
+        m.spinners.store(3, Ordering::Relaxed);
+        STATICS[STATIC_COUNT - 1].spinners.store(1, Ordering::Relaxed);
+        reset_after_fork_in_child();
+        assert_eq!(spinners(p), 0);
+        assert!(STATICS.iter().all(|m| m.spinners.load(Ordering::Relaxed) == 0));
+    }
 }
