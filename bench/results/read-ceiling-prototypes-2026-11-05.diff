+// ---- PROTOTYPE (scratch only): spin briefly before parking on any SQLite mutex. ----
+#[allow(unsafe_code, static_mut_refs, clippy::all)]
+mod spin {
+    use rusqlite::ffi;
+    use std::sync::Once;
+
+    static mut ORIG: ffi::sqlite3_mutex_methods = ffi::sqlite3_mutex_methods {
+        xMutexInit: None,
+        xMutexEnd: None,
+        xMutexAlloc: None,
+        xMutexFree: None,
+        xMutexEnter: None,
+        xMutexTry: None,
+        xMutexLeave: None,
+        xMutexHeld: None,
+        xMutexNotheld: None,
+    };
+
+    fn spins() -> u32 {
+        std::env::var("DCO_SPIN").ok().and_then(|v| v.parse().ok()).unwrap_or(200)
+    }
+    static mut SPINS: u32 = 200;
+
+    unsafe extern "C" fn enter(m: *mut ffi::sqlite3_mutex) {
+        unsafe {
+            let try_ = ORIG.xMutexTry.unwrap();
+            for _ in 0..SPINS {
+                if try_(m) == ffi::SQLITE_OK {
+                    return;
+                }
+                std::hint::spin_loop();
+            }
+            ORIG.xMutexEnter.unwrap()(m);
+        }
+    }
+
+    pub fn install() -> i32 {
+        static ONCE: Once = Once::new();
+        static mut RC: i32 = -1;
+        ONCE.call_once(|| unsafe {
+            SPINS = spins();
+            crate::pool::POOL_SPIN.store(std::env::var("DCO_POOL_SPIN").ok().and_then(|v| v.parse().ok()).unwrap_or(0), std::sync::atomic::Ordering::Relaxed);
+            if SPINS == 0 {
+                RC = 0;
+                return;
+            }
+            if ffi::sqlite3_initialize() != ffi::SQLITE_OK { RC = -2; return; }
+            ffi::sqlite3_shutdown();
+            let rc = ffi::sqlite3_config(ffi::SQLITE_CONFIG_GETMUTEX, &raw mut ORIG);
+            if ORIG.xMutexTry.is_none() { RC = -3; return; }
+            if rc != ffi::SQLITE_OK {
+                RC = rc;
+                return;
+            }
+            let mut mine = ORIG;
+            mine.xMutexEnter = Some(enter);
+            static mut MINE: ffi::sqlite3_mutex_methods = ffi::sqlite3_mutex_methods {
+                xMutexInit: None, xMutexEnd: None, xMutexAlloc: None, xMutexFree: None,
+                xMutexEnter: None, xMutexTry: None, xMutexLeave: None, xMutexHeld: None, xMutexNotheld: None,
+            };
+            MINE = mine;
+            RC = ffi::sqlite3_config(ffi::SQLITE_CONFIG_MUTEX, &raw const MINE);
+            ffi::sqlite3_initialize();
+        });
+        unsafe { RC }
+    }
